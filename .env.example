# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=smart-ai-companion.local,localhost,127.0.0.1

# First-boot Wi-Fi setup (required on the Raspberry Pi; use a unique secret)
SETUP_AP_PASSWORD=
SETUP_SAVED_PROFILE_ATTEMPTS=5
SETUP_CONNECT_COOLDOWN_SECONDS=5

# AI Engine
# Supported: mock (default), local (requires Ollama)
AI_ENGINE=mock

# Ollama (only used when AI_ENGINE=local)
# Install Ollama: https://ollama.com
# Then: ollama pull qwen3.5:4b-q4_K_M
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_THINK=false
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=120
# Appliance recommendation: retain the primary model through normal idle periods.
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PREDICT=128
# Healthy BALANCED/PERFORMANCE voice ceiling only (hard maximum 512).
# BRIEF/NORMAL/DETAILED request 32/64/192; ECO/PROTECTIVE caps do not rise.
AI_GENERATION_NORMAL_VOICE_NUM_PREDICT=384
CHAT_REQUEST_TIMEOUT_SECONDS=30
CHAT_STREAM_IDLE_TIMEOUT_SECONDS=45

# Same-conversation memory only; no summarizer, embeddings or network calls.
CONVERSATION_RECENT_MESSAGES=4
VOICE_RECENT_MESSAGES=2
CONVERSATION_MEMORY_TOP_K=2
CONVERSATION_MEMORY_MAX_CHARS=400
CONVERSATION_MEMORY_MIN_RELEVANCE=0.5

# Offline local knowledge / RAG
# Enable after running migrations and indexing a supported document.
RAG_ENABLED=false
RAG_RETRIEVER=lexical
RAG_CHUNK_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=100
RAG_TOP_K=2
RAG_MAX_CONTEXT_CHARS=1200
# Ordinary RAG answers only; detailed requests retain resource-bounded budgets.
RAG_NUM_PREDICT=64
RAG_MIN_RELEVANCE=0.5
# RAG uses OLLAMA_MODEL; no second-model warm-up or residency.

# Optional self-hosted online retrieval (answers are still generated by Ollama)
ONLINE_RETRIEVAL_ENABLED=false
ONLINE_PROVIDER=searxng
ONLINE_TIMEOUT_SECONDS=8
ONLINE_MAX_RESULTS=4
ONLINE_MAX_CONTEXT_CHARS=6000
SEARXNG_BASE_URL=http://127.0.0.1:8888

# Optional ESP32 LED and DHT22 integration through local Mosquitto
DEVICE_CONTROL_ENABLED=false
DEVICE_TRANSPORT=mqtt
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_KEEPALIVE=30
MQTT_COMMAND_TIMEOUT_SECONDS=5
MQTT_TOPIC_PREFIX=smart-companion
ESP32_DEVICE_ID=companion-esp32-01

# whisper.cpp threads, with or without optional Silero VAD
STT_WHISPER_THREADS=4
STT_VAD_ENABLED=false
STT_VAD_MODEL=
STT_VAD_THRESHOLD=0.5
STT_VAD_MIN_SPEECH_MS=250
STT_VAD_MIN_SILENCE_MS=700
STT_VAD_SPEECH_PAD_MS=100

# Standalone Raspberry Pi voice loop
# Optional USB serial companion face; use the Pi's own /dev/serial/by-id/... path.
COMPANION_DISPLAY_ENABLED=false
COMPANION_DISPLAY_PORT=
COMPANION_DISPLAY_BAUD=115200
COMPANION_DISPLAY_STARTUP_DELAY_SECONDS=1.5

# Pulse remains the compatible development default. Recommended Pi I2S overrides:
# VOICE_AUDIO_BACKEND=alsa
# VOICE_ALSA_CAPTURE_DEVICE=hw:CARD=sndrpigooglevoi,DEV=0
# VOICE_ALSA_PLAYBACK_DEVICE=hw:CARD=sndrpigooglevoi,DEV=0
# VOICE_PLAYBACK_GAIN=4.0
# VOICE_LEADING_SILENCE_SECONDS=0.5
VOICE_AUDIO_BACKEND=pulse
VOICE_ALSA_CAPTURE_DEVICE=hw:CARD=sndrpigooglevoi,DEV=0
VOICE_ALSA_PLAYBACK_DEVICE=hw:CARD=sndrpigooglevoi,DEV=0
VOICE_PLAYBACK_GAIN=4.0
# Required only for pulse: copy the source returned by pactl list short sources.
VOICE_INPUT_SOURCE=
# Opt-in hands-free ALSA mode: prepare model, enable, then use --hands-free.
# Built-in Phase 1 phrase: "Hey Jarvis". A custom .onnx/.tflite path overrides MODEL.
VOICE_WAKE_WORD_ENABLED=false
VOICE_WAKE_WORD_ENGINE=openwakeword
VOICE_WAKE_WORD_MODEL=hey_jarvis
VOICE_WAKE_WORD_MODEL_PATH=
VOICE_WAKE_WORD_THRESHOLD=0.5
VOICE_WAKE_WORD_VAD_THRESHOLD=0.5
# 0 waits indefinitely. VAD threshold 0 disables wake-engine VAD only.
VOICE_WAKE_WORD_TIMEOUT_SECONDS=0
# After fully drained playback; bounded to 0..5 seconds.
VOICE_WAKE_WORD_COOLDOWN_SECONDS=0.75
# Deprecated compatibility setting; the new hands-free recorder ignores it.
VOICE_HANDS_FREE_VAD_MAX_START_THRESHOLD=0.10
VOICE_HANDS_FREE_WARMUP_SECONDS=0.25
VOICE_HANDS_FREE_CALIBRATION_SECONDS=0.25
VOICE_HANDS_FREE_MAX_SECONDS=6.0
VOICE_HANDS_FREE_END_SILENCE_SECONDS=0.9
VOICE_RECORD_SECONDS=5
VOICE_INPUT_WARMUP_SECONDS=1.0
VOICE_CAPTURE_VAD_ENABLED=false
VOICE_CAPTURE_VAD_START_THRESHOLD=0.02
VOICE_CAPTURE_VAD_SILENCE_SECONDS=0.8
VOICE_CAPTURE_VAD_MAX_SECONDS=10
VOICE_CAPTURE_VAD_START_TIMEOUT_SECONDS=5
# Capture-only adaptive RMS gate; independent of Whisper/Silero STT VAD.
VOICE_CAPTURE_VAD_ADAPTIVE=true
VOICE_CAPTURE_VAD_NOISE_CALIBRATION_SECONDS=0.5
VOICE_CAPTURE_VAD_START_CONFIRM_MS=60
VOICE_CAPTURE_VAD_MIN_SPEECH_MS=300
VOICE_LEADING_SILENCE_SECONDS=0.7
# Recommended with the ALSA Pi backend: VOICE_LEADING_SILENCE_SECONDS=0.5
# Streaming fallback target; completed sentences can be spoken earlier.
VOICE_STREAM_TTS_TARGET_CHARS=180
# First unit only: allow a safe natural clause near target; never force a cut.
VOICE_STREAM_FIRST_CHUNK_MIN_CHARS=60
VOICE_STREAM_FIRST_CHUNK_TARGET_CHARS=100
# Persistent ALSA stream: total retained-silence + injected PCM boundary target.
VOICE_STREAM_INTER_CHUNK_SILENCE_SECONDS=0.12
# Legacy batch helpers only; the streaming voice loop does not truncate output.
VOICE_TTS_CHUNK_CHARS=300
VOICE_TTS_MAX_TOTAL_CHARS=0
VOICE_LLM_BRIEF_NUM_PREDICT=32
VOICE_LLM_NORMAL_NUM_PREDICT=64
VOICE_LLM_DETAILED_NUM_PREDICT=192
