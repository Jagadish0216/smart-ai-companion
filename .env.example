# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=smart-ai-companion.local,localhost,127.0.0.1

# First-boot Wi-Fi setup (required on the Raspberry Pi; use a unique secret)
SETUP_AP_PASSWORD=
SETUP_SAVED_PROFILE_ATTEMPTS=5
SETUP_CONNECT_COOLDOWN_SECONDS=5

# AI Engine
# Supported: mock (default), local (requires Ollama)
AI_ENGINE=mock

# Ollama (only used when AI_ENGINE=local)
# Install Ollama: https://ollama.com
# Then: ollama pull llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_LIGHTWEIGHT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120
# Appliance recommendation: retain the primary model through normal idle periods.
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PREDICT=128
CHAT_REQUEST_TIMEOUT_SECONDS=30
CHAT_STREAM_IDLE_TIMEOUT_SECONDS=45

# Same-conversation memory only; no summarizer, embeddings or network calls.
CONVERSATION_RECENT_MESSAGES=4
CONVERSATION_MEMORY_TOP_K=2
CONVERSATION_MEMORY_MAX_CHARS=400
CONVERSATION_MEMORY_MIN_RELEVANCE=0.5

# Offline local knowledge / RAG
# Enable after running migrations and indexing a supported document.
RAG_ENABLED=false
RAG_RETRIEVER=lexical
RAG_MODEL=llama3.2:1b
RAG_CHUNK_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=100
RAG_TOP_K=2
RAG_MAX_CONTEXT_CHARS=1200
# Ordinary RAG answers only; detailed requests retain resource-bounded budgets.
RAG_NUM_PREDICT=64
RAG_MIN_RELEVANCE=0.5
# Optional best-effort RAG warm-up in the existing service; primary warms last.
RAG_PREWARM_ENABLED=false
RAG_PREWARM_TIMEOUT_SECONDS=20

# Optional self-hosted online retrieval (answers are still generated by Ollama)
ONLINE_RETRIEVAL_ENABLED=false
ONLINE_PROVIDER=searxng
ONLINE_TIMEOUT_SECONDS=8
ONLINE_MAX_RESULTS=4
ONLINE_MAX_CONTEXT_CHARS=6000
SEARXNG_BASE_URL=http://127.0.0.1:8888

# Optional ESP32 LED and DHT22 integration through local Mosquitto
DEVICE_CONTROL_ENABLED=false
DEVICE_TRANSPORT=mqtt
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_KEEPALIVE=30
MQTT_COMMAND_TIMEOUT_SECONDS=5
MQTT_TOPIC_PREFIX=smart-companion
ESP32_DEVICE_ID=companion-esp32-01

# Optional whisper.cpp Silero VAD
STT_VAD_ENABLED=false
STT_VAD_MODEL=
STT_VAD_THRESHOLD=0.5
STT_VAD_MIN_SPEECH_MS=250
STT_VAD_MIN_SILENCE_MS=700
STT_VAD_SPEECH_PAD_MS=100

# Standalone Raspberry Pi voice loop
# Copy the exact Realme Buds source returned by: pactl list short sources
VOICE_INPUT_SOURCE=
VOICE_RECORD_SECONDS=5
VOICE_INPUT_WARMUP_SECONDS=1.0
VOICE_CAPTURE_VAD_ENABLED=false
VOICE_CAPTURE_VAD_START_THRESHOLD=0.02
VOICE_CAPTURE_VAD_SILENCE_SECONDS=0.8
VOICE_CAPTURE_VAD_MAX_SECONDS=10
VOICE_CAPTURE_VAD_START_TIMEOUT_SECONDS=5
VOICE_LEADING_SILENCE_SECONDS=0.7
VOICE_TTS_CHUNK_CHARS=300
VOICE_TTS_MAX_TOTAL_CHARS=0
VOICE_LLM_BRIEF_NUM_PREDICT=96
VOICE_LLM_NORMAL_NUM_PREDICT=160
VOICE_LLM_DETAILED_NUM_PREDICT=384
