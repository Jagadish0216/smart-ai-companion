[Unit]
Description=Smart AI Companion first-boot network mode
Wants=NetworkManager.service avahi-daemon.service
After=NetworkManager.service avahi-daemon.service
Before=smart-ai-companion.service

[Service]
Type=oneshot
User=jagadish
Group=jagadish
WorkingDirectory=/home/jagadish/apps/smart-ai-companion
EnvironmentFile=/home/jagadish/apps/smart-ai-companion/.env
ExecStart=/home/jagadish/apps/smart-ai-companion/venv/bin/python /home/jagadish/apps/smart-ai-companion/manage.py ensure_network_mode
TimeoutStartSec=90
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
