[Unit]
Description=Smart AI Companion first-boot network mode
Wants=NetworkManager.service
After=NetworkManager.service
Before=smart-ai-companion-web.service

[Service]
Type=oneshot
WorkingDirectory=/opt/smart-ai-companion
ExecStart=/opt/smart-ai-companion/venv/bin/python /opt/smart-ai-companion/manage.py ensure_network_mode
TimeoutStartSec=90
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
