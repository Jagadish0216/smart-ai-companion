+"""Bounded fallback policy: explicit refusal/failure, never model confidence."""
+import re
+
+_REFUSAL = re.compile(
+    r"^(?:(?:sorry|unfortunately)[,. ]+)?(?:"
+    r"i (?:don't|do not) (?:know|have (?:enough |the |sufficient )?(?:information|knowledge|answer))|"
+    r"i (?:cannot|can't|am unable to|'m unable to) (?:answer|provide|verify)|"
+    r"i'm unable to (?:answer|provide|verify))\b", re.I)
+_PREFIXES = ("i don't know", "i do not know", "i don't have", "i do not have",
+             "i cannot", "i can't", "i am unable", "i'm unable", "sorry", "unfortunately")
+
+
+def refused(text):
+    # A policy/safety refusal is not evidence of missing factual knowledge.
+    if re.search(r"\b(?:harmful|illegal|unsafe|weapons?|privacy|personal data|malware|violence)\b", text, re.I):
+        return False
+    return bool(_REFUSAL.search(text.strip()))
+
+
+def private_query(query):
+    from .routing import requests_local_knowledge
+    return requests_local_knowledge(query) or bool(re.search(
+        r"\b(?:my|our|uploaded|attached|supplied)\b|\bthis (?:repository|project)\b", query, re.I))
+
+
+def officeholder_background(query):
+    """Last-known background is useful, unlike invented live weather/prices."""
+    return bool(re.search(r"\bwho (?:is|leads|runs)\b", query, re.I) and re.search(
+        r"\b(?:prime minister|president|chief minister|governor|mayor|ceo)\b", query, re.I))
+
+
+BACKGROUND_INSTRUCTION = (
+    "Live verification is unavailable. Give last-known background from model knowledge "
+    "only if you know it. Do not claim that an officeholder is verified current. "
+    "If unknown, say so. Never invent dates, citations, sources or search results."
+)
+BACKGROUND_PREFIX = "Local knowledge, not live-verified; officeholders can change. "
+
+
+def defensible_background(text):
+    # No evidence was acquired: discard source/date/verification claims rather
+    # than presenting a fabricated citation behind a freshness disclaimer.
+    if refused(text) or re.search(
+        r"https?://|\[\d+\]|\bas of\b|\b(?:I (?:searched|checked|verified)|"
+        r"verified current|according to (?:the )?(?:latest|search|web))\b", text, re.I
+    ):
+        return 'I cannot verify the current officeholder from the available information.'
+    return text
+
+
+class RefusalGate:
+    """Hold only a possible initial refusal, at most 192 characters.
+
+    Normal factual prose streams immediately. Never revise an answer already
+    delivered to the caller or speaker. Ambiguous endings are resolved at EOF.
+    """
+    def __init__(self):
+        self.pending = ''
+        self.released = False
+        self.refusal = False
+
+    def feed(self, text, final=False):
+        if self.released:
+            return text
+        self.pending += text
+        normalized = ' '.join(self.pending.lower().split())
+        if refused(self.pending) and (final or re.search(r'[.!?](?:\s|$)', self.pending) or len(self.pending) >= 192):
+            self.refusal = True
+            return ''
+        possible = not normalized or any(p.startswith(normalized) or normalized.startswith(p) for p in _PREFIXES)
+        if final or not possible or len(self.pending) >= 192 or re.search(r'[.!?]\s', self.pending):
+            self.released = True
+            result, self.pending = self.pending, ''
+            return result
+        return ''
